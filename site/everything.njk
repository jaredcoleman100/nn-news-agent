---
layout: base.njk
navKey: everything
pagination:
  data: items
  size: 60
  alias: chunk
permalink: "{% if pagination.pageNumber == 0 %}everything/index.html{% else %}everything/page/{{ pagination.pageNumber + 1 }}/index.html{% endif %}"
---
{% from "card.njk" import list, pager %}
<p class="sub">{{ items | length }} {{ site.t.items[0] }} · {{ collections.external | length }} {{ site.t.external[0] | lower }} · {{ collections.own | length }} {{ site.t.own[0] }}
<span class="alt">{{ items | length }} {{ site.t.items[1] }} · {{ collections.external | length }} {{ site.t.external[1] | lower }} · {{ collections.own | length }} {{ site.t.own[1] }}</span></p>
{{ list(chunk, site, linkBase) }}
{{ pager(pagination, site, linkBase) }}
